# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# PostgreSQL with pgvector enabled
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set to disable only for a trusted local database.
DATABASE_SSL=require

# Telegram bot and Mini App
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Use the primary hostname directly; the apex redirects to www in Vercel.
TELEGRAM_MINI_APP_URL=https://www.isnadsunnah.site/telegram
PUBLIC_BASE_URL=https://www.isnadsunnah.site
