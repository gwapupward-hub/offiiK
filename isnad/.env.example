# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# PostgreSQL with pgvector enabled
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set to disable only for a trusted local database.
DATABASE_SSL=require

# Telegram bot and Mini App
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Use the primary hostname directly; the apex redirects to www in Vercel.
TELEGRAM_MINI_APP_URL=https://www.isnadsunnah.site/telegram
PUBLIC_BASE_URL=https://www.isnadsunnah.site

# Community Admin Control Center (ISN-C0). Off unless explicitly enabled.
# See docs/community/c0-foundation.md before turning this on anywhere.
ISNAD_COMMUNITY_ENABLED=false
# Operator kill switch: stops all community automation.
ISNAD_COMMUNITY_GLOBAL_PAUSE=false
# Optional: avoids a getMe lookup when routing /command@bot in groups.
TELEGRAM_BOT_USERNAME=the_isnad_bot
# Short name of the Mini App registered in BotFather (t.me/<bot>/<short_name>).
TELEGRAM_MINI_APP_SHORT_NAME=askiik
# Protects GET /api/internal/telegram-inbox (inbox retries and retention).
CRON_SECRET=
