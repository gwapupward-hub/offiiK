# Anthropic — required for the Claude toggle (the default provider).
ANTHROPIC_API_KEY=

# OpenAI — required only for the OpenAI toggle.
OPENAI_API_KEY=

# Telegram Mini App — bot token from @BotFather. Used server-side to validate
# the signed initData sent by the /telegram Mini App. Set it in Vercel project
# settings (same place as ANTHROPIC_API_KEY).
TELEGRAM_BOT_TOKEN=
