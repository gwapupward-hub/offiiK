# OpenAI — required. Powers every answer (web app, Telegram bot, and Mini App).
OPENAI_API_KEY=

# Telegram bot token from @BotFather. Used server-side to (a) validate the
# signed initData sent by the /telegram Mini App, and (b) send/receive messages
# for the @the_isnad_bot chat bot. Set it in Vercel project settings (same place
# as OPENAI_API_KEY).
TELEGRAM_BOT_TOKEN=

# Shared secret for the Telegram bot webhook. Pick any hard-to-guess string
# (e.g. `openssl rand -hex 32`). scripts/telegram-setup.mjs registers it with
# Telegram as the webhook secret_token; the /api/telegram/webhook route verifies
# the matching header so only Telegram can drive the bot. Use the SAME value in
# both places.
TELEGRAM_WEBHOOK_SECRET=
